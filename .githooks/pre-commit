#!/bin/sh
# AngkorFetch pre-commit gate.
#
# Enable once per clone:   git config core.hooksPath .githooks
#
# Runs only the checks that match the staged files and aborts the commit when any
# of them fails. Checks run against the working tree, so unstaged edits to the same
# files are checked too. Bypassing (--no-verify) requires maintainer approval.

set -eu

# Area matching includes deletions (D): removing a .rs file or the golden fixture must
# still trigger the checks. quotePath=false keeps non-ASCII names unquoted.
staged=$(git -c core.quotePath=false diff --cached --name-only --diff-filter=ACMRD)
[ -n "$staged" ] || exit 0

matches() {
    printf '%s\n' "$staged" | grep -Eq "$1"
}

fail() {
    printf 'pre-commit: %s\n' "$1" >&2
    printf 'pre-commit: commit aborted. Fix the issue, re-stage, and commit again.\n' >&2
    exit 1
}

run() {
    printf 'pre-commit: %s\n' "$*"
    "$@" || fail "failed: $*"
}

if matches '\.rs$|(^|/)Cargo\.(toml|lock)$'; then
    command -v cargo >/dev/null 2>&1 || fail "cargo not found; install Rust from https://rustup.rs"
    run cargo fmt --check
    run cargo clippy --all-targets --all-features --locked -- -D warnings
fi

if matches '^(scripts|Formula|winget-pkgs)/'; then
    py=""
    for candidate in "python3" "python" "py -3"; do
        # Unquoted on purpose: "py -3" is a command plus an argument.
        if $candidate -c 'import sys; sys.exit(sys.version_info[0] < 3)' >/dev/null 2>&1; then
            py=$candidate
            break
        fi
    done
    [ -n "$py" ] || fail "python 3 not found on PATH (tried python3, python, py -3)"
    run $py -m unittest discover -s scripts -p "test_*.py"
    run $py scripts/sync_package_manifests.py --check
fi

if matches '\.sh$'; then
    command -v bash >/dev/null 2>&1 || fail "bash not found"
    # Syntax-check only files that still exist (not deletions).
    git -c core.quotePath=false diff --cached --name-only --diff-filter=ACMR |
        grep -E '\.sh$' | while IFS= read -r file; do
            run bash -n "$file"
        done
fi

exit 0
